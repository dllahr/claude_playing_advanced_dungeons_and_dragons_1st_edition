# Track the text. Ignore the scans and everything generated from them.
#
# The whole tree is ~229 MB; the part worth versioning is under 2 MB. The rest
# is either immutable (scanned PDFs, which git would store once and never diff)
# or regenerated on demand (mapdb/output, which is binary SQLite and PNGs that
# change wholesale on every rebuild and would bloat history fast).

# --- the books: large, binary, and they never change ---
manuals/
modules/*.pdf
modules/*.txt

# --- DERIVED VIEWS. Both are rebuilt from the TSVs, which ARE the record. ---
campaign/output/
mapdb/output/
mapdb/**/*.sqlite
mapdb/**/*.png

# --- conversation exports, kept locally as archives ---
*_session.txt
*_session_snapshot.txt
*_export.txt
dlwork/*_session_snapshot.txt

# --- python / macOS noise ---
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
